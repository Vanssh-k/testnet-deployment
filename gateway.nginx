# Default server configuration

server {
listen 8080;

        server_name _;

        location /ipfs/ {
                proxy_set_header Host $host;
                proxy_set_header X-Forwarded-For $remote_addr;
                proxy_pass http://localhost:5050;
        }

        location /api/v0 {
                proxy_pass http://localhost:5001;
        }

}
