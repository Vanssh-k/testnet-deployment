server {

    listen 80;

    server_name _;

    location /robots.txt {
        alias /home/robots.txt;
    }

	location /ipns {
        proxy_pass http://10.0.9.53;
    }

    location /api/v0/dag/stat {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://localhost:5001;
    }

    location /api/v0/cat {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
            proxy_pass http://localhost:5001;
    }

    location /api/v0/get {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://localhost:5001;
    }

    location /api/v0/ls {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://localhost:5001;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://localhost:8090;
    }
}
