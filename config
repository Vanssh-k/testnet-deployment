# Default server configuration

server {

        listen 80;

        server_name _;

        location /ipfs/ {
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_pass http://localhost:5050;
        }

        location /api/v0/dag/stat {
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_pass http://localhost:5050;
        }

        location /api/v0/cat {
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
                proxy_pass http://localhost:5050;
        }

        location /api/v0/get {
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_pass http://localhost:5050;
        }

}
